{
  "name": "vergil-lai/lexsift-php",
  "description": "Pure PHP implementation of the LexSift Unicode-aware text matcher",
  "keywords": [
    "keyword-matching",
    "phrase-matching",
    "text-matching",
    "aho-corasick",
    "sensitive-filter"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-intl": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "pestphp/pest": "^3.0 || ^4.0",
    "phpstan/phpstan": "^2.2.14"
  },
  "autoload": {
    "psr-4": {
      "VergilLai\\LexSift\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "VergilLai\\LexSift\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest",
    "test:coverage": "pest --coverage --min=85",
    "test:release": "bash tests/Release/package-smoke.sh",
    "stan": "phpstan analyse --memory-limit=1G --debug",
    "cs": "php-cs-fixer fix --dry-run --diff --sequential",
    "cs:fix": "php-cs-fixer fix",
    "check": [
      "@cs",
      "@stan",
      "@test"
    ]
  }
}
